{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      ".claude",
      "app-panes",
      "dist",
      "dist-addon",
      "node_modules",
      "scripts/agmsg-addon-check.cjs",
      "scripts/agmsg-addon-copy.mjs",
      "src/vendor"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "organizeImports": {
    "enabled": true
  }
}
